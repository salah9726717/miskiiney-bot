# Required
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ADMIN_IDS=123456789

# Webhook deployment (Render / VPS). Leave WEBHOOK_URL empty to use long polling.
WEBHOOK_URL=
WEBHOOK_SECRET=change-this-to-a-long-random-secret
PORT=3000
NODE_ENV=production

# Required storage channels. The bot must be an administrator in each channel.
FILMS_CHANNEL_ID=-1004293346319
SERIES_CHANNEL_ID=-1004466790780
BOOKS_CHANNEL_ID=-1004422146264
CURRICULUM_CHANNEL_ID=-1003964674328

# Optional group integration. Add bot to the group and set its ID here.
GROUP_CHAT_ID=
GROUP_WELCOME_ENABLED=true

# Public bot username without @; used to build invite/share links.
BOT_USERNAME=Miskiineybot
SUPPORT_USERNAME=Desing_La_KingS99
SYSTEM_SUPPORT_PHONE=252687768306

# Optional OpenRouter AI. Bot still runs if these are empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_ENABLED=false

# Optional limits
SEARCH_LIMIT=8
BROADCAST_DELAY_MS=40
